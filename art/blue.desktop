# Blue's entry for Linux desktops, which gives its window (class and app ID
# "blue") its icon. To install: this file in ~/.local/share/applications,
# the icons (art/png/blue-N.png) as ~/.local/share/icons/hicolor/NxN/apps/blue.png
# (the release archives have them laid out so: copy their share/ to ~/.local/).
[Desktop Entry]
Type=Application
Name=Blue
GenericName=Classic Mac OS
Comment=Classic Mac OS on a native kernel
Exec=blue
Icon=blue
Terminal=false
NoDisplay=true
StartupWMClass=blue
Categories=System;Emulator;
